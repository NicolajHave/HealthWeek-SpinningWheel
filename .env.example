# Supabase project URL (the shared SELECTED project).
NEXT_PUBLIC_SUPABASE_URL=https://xpfoozuhndqnhvfyokki.supabase.co

# Service role key, from Supabase Settings -> API -> service_role.
# Server only — never prefix with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Unlocks /admin (team list + per-team reset). Exempt from the kiosk cookie.
ADMIN_PIN=

# Unlocks spinning on the physical screen. Visit /?kiosk=<KIOSK_SECRET> once on
# the kiosk browser the morning of the event.
KIOSK_SECRET=

# Where the Power-Up is collected. Shown verbatim on the result screen. Keep it
# specific enough to walk to, and don't repeat what POWER_UP_PRIZE already says.
POWER_UP_LOCATION=the counter in Restauranten

# What the Power-Up is. Reads as the subject of a sentence, so give it a phrase
# and a capital letter: "<this> is waiting for your team at <location>."
POWER_UP_PRIZE=Something delicious from the restaurant

# Where the kiosk screen stands. Shown to anyone viewing the board read-only.
KIOSK_LOCATION=the canteen

# The best-photo prize. Always rendered in caps, so case does not matter, but
# it follows "wins" with no article: "Best team photo wins <this>".
PHOTO_PRIZE=something delicious from the restaurant
